{
  "files": ["**/*.{js,mjs,cjs,vue,json,jsonc,md,yml,yaml}"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell-project-words.txt"
    }
  ],
  "dictionaries": ["project-words", "bash", "misc", "node", "softwareTerms"],
  "ignorePaths": [
    ".git/",
    "node_modules/",
    "**/node_modules/",
    "drupal/",
    "nuxt/dist/",
    "nuxt/.nuxt/",
    "coverage/",
    "test-results/",
    "playwright-report/",
    ".vale/",
    "*.lock",
    "package-lock.json",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.ico",
    ".devcontainer/extensions/*/*.vsix"
  ],
  "useGitignore": true,
  "ignoreRegExpList": ["/G-[A-Z0-9]{6,}/g"]
}
