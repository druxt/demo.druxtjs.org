{
  "name": "demo.druxtjs.org",
  "version": "1.0.0",
  "private": true,
  "description": "The source of demo.druxtjs.org: a Drupal backend with Tome content and a Nuxt front end built with Druxt.",
  "packageManager": "npm@8.19.2",
  "engines": {
    "node": ">=16.18.1"
  },
  "scripts": {
    "setup": "npm run assemble && npm run provision && npm run start",
    "assemble": "cd drupal && .devtools/assemble",
    "provision": "cd drupal && .devtools/provision",
    "start": "cd drupal && .devtools/start",
    "stop": "cd drupal && .devtools/stop",
    "info": "cd drupal && .devtools/info",
    "dev": "npm --prefix nuxt run dev",
    "build": "npm --prefix nuxt run build",
    "generate": "npm --prefix nuxt run generate",
    "serve": "node scripts/serve.mjs nuxt/dist 3000",
    "test": "npm --prefix nuxt run test:unit",
    "test:scripts": "node --test test/serve.test.mjs",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "lint": "npm run lint:js && npm run lint:format && npm run lint:md && npm run lint:cspell && npm run lint:private && npm run lint:attribution && npm run lint:knip",
    "lint:js": "eslint --ext .js,.mjs,.cjs scripts test playwright.config.js",
    "lint:format": "prettier --check \"**/*.{js,mjs,cjs,json,jsonc,md,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"**/*.{js,mjs,cjs,json,jsonc,md,yml,yaml}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "lint:cspell": "cspell lint --no-progress --no-must-find-files --gitignore --dot \"**/*.{js,mjs,cjs,vue,json,jsonc,md,yml,yaml}\"",
    "lint:private": "node scripts/lint-private-refs.mjs",
    "lint:attribution": "bash .gitlab/scripts/check-attribution.sh",
    "lint:prose": "PROSE_LINT_GLOB='!drupal/**' bash .gitlab/scripts/lint-prose.sh --all",
    "lint:prose:install": "bash .gitlab/scripts/install-vale.sh .vale/bin .vale/styles",
    "lint:knip": "knip --include dependencies,unlisted --no-config-hints",
    "lint:commit": "commitlint",
    "lint:audit": "npm audit --omit=dev --audit-level=high && npm --prefix nuxt audit --omit=dev --audit-level=high",
    "lint:renovate": "npx --yes --package renovate renovate-config-validator",
    "hooks:install": "node scripts/postinstall.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.44.1",
    "cspell": "7.3.9",
    "eslint": "8.28.0",
    "eslint-config-prettier": "8.10.0",
    "knip": "2.43.0",
    "markdownlint-cli2": "0.10.0",
    "prettier": "3.3.3"
  }
}
