--- a/lib/Drupal/Core/Database/Connection.php
+++ b/lib/Drupal/Core/Database/Connection.php
@@ -1673,6 +1673,16 @@
       return;
     }
 
+    // The PDO handle is already gone. This happens at shutdown when a
+    // Transaction object is destroyed after the connection it belongs to,
+    // an order PHP does not define for objects in a reference cycle. There
+    // is nothing left to commit or release, and a query here dies with a
+    // TypeError that fails an otherwise complete drush site:install.
+    if ($this->connection === NULL) {
+      $this->transactionLayers = [];
+      return;
+    }
+
     // Mark this layer as committable.
     $this->transactionLayers[$name] = FALSE;
     $this->popCommittableTransactions();
--- a/modules/sqlite/src/Driver/Database/sqlite/Connection.php
+++ b/modules/sqlite/src/Driver/Database/sqlite/Connection.php
@@ -191,9 +191,12 @@
             unlink($this->connectionOptions['database'] . '-' . $prefix);
           }
         }
-        catch (\Exception $e) {
-          // Ignore the exception and continue. There is nothing we can do here
-          // to report the error or fail safe.
+        catch (\Throwable $e) {
+          // Ignore the error and continue. There is nothing we can do here to
+          // report it or fail safe. \Throwable rather than \Exception: at
+          // shutdown the PDO handle can already be gone, and the resulting
+          // TypeError is not an \Exception, so it escaped this block and took
+          // down every drush site:install that dropped a table.
         }
       }
     }
