#!/usr/bin/env php
<?php

/**
 * @file
 * Provision the site from the committed configuration and Tome content.
 *
 * The site is fully described by drupal/config and drupal/content, so this
 * is `drush tome:install` against a throwaway SQLite database rather than a
 * fresh site:install. It is the Docker-free equivalent of the DDEV
 * `drupal-install` command and produces the same site.
 *
 * The SQLite override is written to web/sites/default/settings.local.php,
 * which is gitignored. The committed settings.php includes that file when
 * it exists, so every run only ever touches the ignored file.
 */

declare(strict_types=1);

namespace DemoDevTools;

require_once __DIR__ . '/helpers.php';

// -----------------------------------------------------------------------------
// Variables.
// -----------------------------------------------------------------------------

$db_file = resolve_env_value('DB_FILE', '/tmp/druxtjs-demo-drupal-site.sqlite')[0];

// -----------------------------------------------------------------------------

echo '===============================' . PHP_EOL;
echo '         🚀 PROVISION          ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;

TASK('Validating tools.');
command_must_exist('php');
if (!is_file('vendor/bin/drush')) {
  FAIL('vendor/bin/drush is missing. Run .devtools/assemble first.');
}
PASS('Tools are valid.');

TASK('Configuring the SQLite database at %s.', $db_file);
if (file_exists($db_file)) {
  unlink($db_file);
}
// var_export() so a path containing quotes stays valid PHP.
$db_file_php = var_export($db_file, TRUE);
// Public files stay at the default sites/default/files, which is gitignored.
// Tome copies them there from ../files on import, and pointing the public
// path at that source directory makes the import copy each file onto itself.
file_put_contents('web/sites/default/settings.local.php', sprintf(
  "<?php\n\n/**\n * @file\n * Provision-only override, written fresh each run by .devtools/provision.\n * Gitignored and never committed.\n */\n\n\$databases['default']['default'] = [\n  'driver' => 'sqlite',\n  'database' => %s,\n];\n\$settings['hash_salt'] = %s;\n\$settings['skip_permissions_hardening'] = TRUE;\n",
  $db_file_php,
  var_export(bin2hex(random_bytes(32)), TRUE)
));
PASS('SQLite database configured.');

TASK('Installing the site from configuration and importing the Tome content.');
drush('tome:install --yes');
PASS('Site installed and content imported.');

TASK('Rebuilding caches.');
drush('cache:rebuild');
PASS('Caches rebuilt.');

echo PHP_EOL;
echo '===============================' . PHP_EOL;
echo '   🚀 PROVISION COMPLETE  ✅  ' . PHP_EOL;
echo '===============================' . PHP_EOL;
echo PHP_EOL;
echo 'Database: ' . $db_file . PHP_EOL;
echo PHP_EOL;
echo '> Next steps:' . PHP_EOL;
echo '  .devtools/start    # Start the webserver' . PHP_EOL;
echo PHP_EOL;
